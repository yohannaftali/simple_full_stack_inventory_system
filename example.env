GITHUB_TOKEN=your_github_token_here
MARIADB_ROOT_PASSWORD=your_mariadb_root_password_here
MARIADB_DATABASE=sfsis
JWT_SECRET=your_jwt_secret_here

# UVICORN configuration
UVICORN_HOST=127.0.0.1
UVICORN_PORT=5000
UVICORN_PORT_SSL=5443
# nginx passthrough ports for the backend (issue #69) - a 1:1 forward to
# UVICORN_PORT/UVICORN_PORT_SSL above, not a replacement for them (both
# stay published too, for direct debugging). Point external/mobile
# clients at these instead of the raw backend ports going forward.
NGINX_EXPOSED_BACKEND_PORT=5001
NGINX_EXPOSED_BACKEND_PORT_SSL=5444

FRONTEND_PORT=8000
FRONTEND_PORT_SSL=8443
# nginx passthrough ports for the frontend (issue #69) - same 1:1 forward
# convention as the backend pair above.
NGINX_EXPOSED_FRONTEND_PORT=8001
NGINX_EXPOSED_FRONTEND_PORT_SSL=8444

# Default backend address the frontend container connects to before anyone
# saves a different one via the Server Config page. "backend" is the
# compose service's DNS name - only reachable from inside the frontend
# container, not from a browser/native client outside the compose network.
FRONTEND_DEFAULT_SERVER_URL=http://backend:5000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234#
ADMIN_TOTP_SECRET=
ADMIN_TOTP=000000

# Boot-time default app timezone (IANA name, e.g. "Asia/Jakarta",
# "America/New_York", "UTC") - only seeds the app_configs.timezone column on
# a fresh install. Afterwards, change the live value via the Application
# Config screen instead of this var; it has no effect on an already-seeded
# database.
APP_TIMEZONE=Asia/Jakarta

# Pins the database container's own clock (belt-and-suspenders only - the
# app itself stores every timestamp as UTC regardless of this).
TZ=UTC

# Android signing key store password for Flet builds. This is only used if
# you are building the Android app from source. If you are using the
# prebuilt APKs, you can leave this blank.
FLET_ANDROID_SIGNING_KEY_STORE_PASSWORD="value"
